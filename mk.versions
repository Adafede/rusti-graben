# Single source of truth for every pinned tool and ratchet. Sourced by ./mk.
# `./mk setup` installs exactly these; every gate refuses a missing or
# mismatched tool, so local and CI cannot drift. Bump deliberately.

# Nightly is only used for miri (nightly tier).
RUST_NIGHTLY="nightly-2026-10-28"

# crate@version, installed with cargo-binstall (prebuilt where available).
CARGO_TOOLS_CI="typos-cli@1.51.1 cargo-deny@0.20.2 cargo-audit@0.22.2 cargo-machete@0.9.2 cargo-semver-checks@0.51.0 echoes@0.10.1 refquiem@0.3.2 zizmor@1.31.1"
CARGO_TOOLS_NIGHTLY="cargo-mutants@27.1.0 cargo-llvm-cov@0.9.1 cargo-hack@0.6.45 cargo-outdated@0.19.0"

# Tombi is not on crates.io; installed from its GitHub release.
TOMBI_VERSION="1.9.7"

# Ratchets: may only go up.
COVERAGE_FAIL_UNDER_LINES="100"
